# Copy to .env and adjust. .env is gitignored; .env.example is committed.
#   cp .env.example .env

# --- Postgres (docker compose reads these too) ---
POSTGRES_DB=football
POSTGRES_USER=football_etl
POSTGRES_PASSWORD=change_me_locally
# Not 5432: avoids colliding with a locally installed Postgres. Keep it low
# (five figures starting with 1) rather than in the 50000s - Windows reserves
# dynamic ranges for Hyper-V/WinNAT, those ranges move on reboot, and a port
# that lands inside one fails to bind with "An attempt was made to access a
# socket in a way forbidden by its access permissions" while the container
# still reports healthy. `netsh int ipv4 show excludedportrange protocol=tcp`
# lists them. 55432 was the original choice and did exactly this.
POSTGRES_PORT=15432
POSTGRES_HOST=localhost

# Read-only role used by the SQL agent from day 5. Never the ETL user.
POSTGRES_RO_USER=football_ro
POSTGRES_RO_PASSWORD=change_me_locally_too

# Server-side guard for agent queries (milliseconds). Applied to the
# read-only role, so no client can opt out of it.
POSTGRES_RO_STATEMENT_TIMEOUT_MS=5000

# --- LLM (LiteLLM routes by the model prefix) ---
# Only the key for the provider you actually use needs a value.
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Provider is chosen by the prefix: gemini/, openai/, anthropic/, groq/
# Model names get retired. `make llm-models` lists what your key can reach.
LLM_MODEL=gemini/gemini-3.8-flash
# Temperature 0: text-to-SQL wants the same answer for the same question, and
# the eval set on day 6 is only meaningful if runs are comparable.
# Some newer models reject this outright. The client then drops it, records
# that it did, and says so - rather than hiding it, which would make the day 6
# accuracy numbers incomparable between runs.
LLM_TEMPERATURE=0
# 30s was too short on a slow link with a ~4.7k-token schema prompt. `make ask`
# prints how long generation actually took, so tune this from the measurement.
LLM_TIMEOUT_S=120
# One repair attempt after a guard refusal. Two rarely helps and doubles cost.
LLM_MAX_REPAIRS=1

# How hard the model may think before answering: none | low | medium | high,
# or empty to send nothing and take the provider default. Gemini 3.x reasons by
# default, which cost ~40s per question here against ~0.1s for the database
# query it produced. The schema, the literal values and the worked examples are
# all in the prompt, so there is little left to reason about. Day 6 measures
# accuracy at each setting instead of assuming more thinking is better.
LLM_REASONING_EFFORT=low

# Retries for transient provider failures only: 503 overload, 429 rate limit,
# timeouts. Waits 1s, then 2s, then 4s. A bad key or a retired model name is
# raised immediately, because retrying those only delays the real message.
LLM_MAX_RETRIES=3
