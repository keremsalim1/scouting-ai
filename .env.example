# Copy to .env and adjust. .env is gitignored; .env.example is committed.
#   cp .env.example .env

# --- Postgres (docker compose reads these too) ---
POSTGRES_DB=football
POSTGRES_USER=football_etl
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=55432
POSTGRES_HOST=localhost

# Read-only role used by the SQL agent from day 5. Never the ETL user.
POSTGRES_RO_USER=football_ro
POSTGRES_RO_PASSWORD=change_me_locally_too

# Server-side guard for agent queries (milliseconds). Applied to the
# read-only role, so no client can opt out of it.
POSTGRES_RO_STATEMENT_TIMEOUT_MS=5000
